# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/droply
REDIS_URL=redis://127.0.0.1:6379
CODE_PEPPER=replace-with-at-least-32-random-characters
MANAGEMENT_PEPPER=replace-with-a-different-32-character-secret
MAX_FILE_BYTES=104857600
MAX_DROP_BYTES=524288000
MAX_FILES_PER_DROP=20

# S3-compatible storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Client (public values only)
VITE_API_URL=http://localhost:4000/api/v1
